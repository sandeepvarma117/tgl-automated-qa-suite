# Default: test environment (https://test.app.tg.org.au/) — leave PLAYWRIGHT_ENV unset.
# Optional override:
# PLAYWRIGHT_BASE_URL=https://test.app.tg.org.au/

# Optional: custom HTML report directory (default is playwright-report vs playwright-report-staging).
# PLAYWRIGHT_HTML_REPORT_DIR=playwright-report-custom

# Staging (B2C login runs once via setup project; requires credentials):
# PLAYWRIGHT_ENV=staging
# PLAYWRIGHT_BASE_URL=https://stage.app.tg.org.au/
# STAGING_B2C_EMAIL=
# STAGING_B2C_PASSWORD=
# If the password contains #, $, spaces, etc., use double quotes so # is not treated as a comment:
# STAGING_B2C_PASSWORD="your-password"
